[
  {
    "plugin_id": "keepawake",
    "name": "keepawake",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Prevent macOS from sleeping while any herdr agent pane is working; allow sleep when all are idle.",
    "manifest_path": "/Users/jason.koon/dotfiles/home/.config/herdr/plugins/keepawake/herdr-plugin.toml",
    "plugin_root": "/Users/jason.koon/dotfiles/home/.config/herdr/plugins/keepawake",
    "enabled": true,
    "platforms": [
      "macos"
    ],
    "events": [
      {
        "on": "pane.agent_status_changed",
        "platforms": [
          "macos"
        ],
        "command": [
          "./keepawake.sh"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]